# LAN IP or DNS name of the gateway host, reachable by browsers.
GATEWAY_HOST=192.168.70.10

# Public DNS name with an A/AAAA record pointing to the gateway host.
# Caddy obtains HTTPS automatically when ports 80/443 are reachable.
GATEWAY_DOMAIN=stream.example.com

# Replace with the real camera RTSP URLs. Keep credentials only on the gateway host.
CAM01_RTSP_URL=rtsp://username:password@192.168.70.130:554/Streaming/Channels/101
CAM02_RTSP_URL=rtsp://username:password@192.168.70.131:554/Streaming/Channels/101
CAM03_RTSP_URL=rtsp://username:password@192.168.70.132:554/Streaming/Channels/101
